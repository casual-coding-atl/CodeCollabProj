# Copy to .env and fill in. .env is gitignored.

# MongoDB connection string (e.g. MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/codecollabproj

# development locally; production on deploy (enables Secure cookies)
NODE_ENV=development

# ── Better Auth (src/server/auth.ts) ─────────────────────────────────────────

# Signs sessions and tokens. Use a long random value. Falls back to JWT_SECRET.
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret

# The app's own origin: the one Better Auth trusts for callbacks and scopes the
# session cookie to. Optional in development (defaults to http://localhost:3000)
# and REQUIRED in production — getAuth() throws without it rather than fall back
# to localhost, which would trust the wrong origin and set a non-Secure cookie.
# BETTER_AUTH_URL=https://app.example.com

# WebAuthn relying-party id. Derived from BETTER_AUTH_URL's hostname; set only
# for deployments where the two differ.
# PASSKEY_RP_ID=example.com

# GitHub OAuth app. The provider registers only when BOTH are present, and is
# configured for account LINKING only — social sign-in and sign-up are off.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ── GitHub API reads (src/server/github.ts) ──────────────────────────────────

# Optional server-side fallback token for reading public GitHub data (linking a
# repository, repo cards). The chain is: the requesting member's own token from
# their Linked GitHub Account → this → unauthenticated. Unauthenticated is 60
# requests/hour for the whole server, so set a token on any deployment members
# will actually use.
#
# It MUST be a fine-grained token with NO scopes and NO repository access beyond
# public repositories — never a classic token with `repo`, and never one with
# write access (this app only ever reads). A token that can see private
# repositories would make the server able to answer questions about them; the
# card endpoint refuses to cache or describe a private repository for exactly
# that reason, but the right fix is a token that could not see one anyway.
# GITHUB_TOKEN=

# Legacy secret from the retired JWT stack; still honoured as the fallback for
# BETTER_AUTH_SECRET so existing deployments keep booting.
JWT_SECRET=change-me-to-a-long-random-secret

# ─────────────────────────────────────────────────────────────────────────────

# Client API base — same-origin proxy by default
VITE_API_URL=/api

# Port for the production server (`npm start`). Set automatically by the host.
# PORT=3000
